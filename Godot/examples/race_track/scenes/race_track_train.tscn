[node name="RaceTrackTrain" type="Node3D"]

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, 0.866, 0, -0.866, 0.5, 0, 50, 0)
shadow_enabled = true

[node name="RaceTrack" parent="." instance=ExtResource("1_race_track")]

[node name="RaceTrackEnvironment" type="ScholaEnvironment" parent="."]
