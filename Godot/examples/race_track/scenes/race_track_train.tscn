[gd_scene load_steps=6 format=3]

[ext_resource type="PackedScene" path="res://examples/race_track/scenes/race_track.tscn" id="1_race_track"]
[ext_resource type="Script" path="res://examples/race_track/scripts/race_track_environment.gd" id="2_environment"]
